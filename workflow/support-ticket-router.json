      "parameters": {
        "jsCode": "const now = new Date();\nconst yyyy = now.getFullYear();\nconst mm = String(now.getMonth() + 1).padStart(2, '0');\nconst dd = String(now.getDate()).padStart(2, '0');\nconst datePart = `${yyyy}${mm}${dd}`;\nconst randomPart = Math.floor(1000 + Math.random() * 9000); // 4 digits, never starts with 0\n\nconst ticketId = `TCK-${datePart}-${randomPart}`;\n\nreturn {\n  ...$input.item.json,\n  ticket_id: ticketId\n};"
      },
