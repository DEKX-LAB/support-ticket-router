    {
      "parameters": {
        "jsCode": "const text = $json.search_text;\n\nconst billingWords = /invoice|refund|payment|receipt|charged|deposit|price paid/;\nconst repairWords = /screen|battery|won't turn on|cracked|charging port|not charging|water damage|repair status|diagnosis|still not fixed/;\nconst salesWords = /price|quote|buy|purchase|sell|selling|how much|availability|available|new phone|brand new|refurbished|in stock|do you have/;\n\nlet category = \"General\";\nif (billingWords.test(text)) {\n  category = \"Billing\";\n} else if (repairWords.test(text)) {\n  category = \"Repair\";\n} else if (salesWords.test(text)) {\n  category = \"Sales\";\n}\n\nreturn {\n  ...$input.item.json,\n  category\n};"
      },
